# Alpha Vantage API key — required.
# Free, instant, email only: https://www.alphavantage.co/support/#api-key
# The free tier is 25 requests/day and end-of-day data only.
ALPHAVANTAGE_API_KEY=

# Contact address sent to SEC EDGAR in the User-Agent header.
# EDGAR requires a declared User-Agent naming the project and a contact;
# undeclared clients get blocked. Kept out of the repo because this is a
# public repository and a committed address is a spam magnet.
SEC_CONTACT_EMAIL=

# Optional: force "weekday" or "weekend" behaviour instead of deciding from
# the date. Useful for testing the weekly/fundamentals path on a Tuesday.
# PETRA_FORCE_MODE=
